# Copie estas variáveis para o Netlify (Site settings → Environment variables)
# e para o Supabase (Project Settings → Database / API).
# NÃO commite valores reais.

# --- Supabase (base de dados Postgres) ---
DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth da aplicação ---
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://o-seu-site.netlify.app
BETTER_AUTH_SECRET=gere-uma-chave-longa-aleatoria

# --- E-mail de boas-vindas (Resend — pode ser o mesmo SMTP do Supabase) ---
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=Auxilar de Vagas <noreply@oseudominio.com>
